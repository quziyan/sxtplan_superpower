{
  "name": "camera-news-prediction",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "test": "bun test",
    "test:integration": "INTEGRATION_TESTS=true bun test tests/integrations/",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "seed:region": "bun src/modules/region/seed.ts",
    "seed:bootstrap": "bun src/db/seed-bootstrap.ts",
    "seed:taxonomy:police": "bun src/seeds/police-taxonomy.ts",
    "seed:demo-data": "bun src/seeds/demo-data.ts",
    "clean:fixtures": "bun scripts/clean-fixture-pollution.ts",
    "demo:real-pipeline": "bun scripts/run-real-pipeline.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.0",
    "@node-rs/argon2": "^2.0.0",
    "ali-oss": "^6",
    "bullmq": "^5",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "ioredis": "^5",
    "postgres": "^3.4.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/ali-oss": "^6.23.3",
    "@types/geojson": "^7946.0.16",
    "bun-types": "^1.3.13",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.6.0"
  }
}

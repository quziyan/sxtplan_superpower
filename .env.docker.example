# Plan-PP docker:`.env.docker` 由 docker-compose 加载,容器间用 service-name 互联
#
# 生产部署:cp .env.docker.example .env.docker,然后改 SESSION_SECRET / DASHSCOPE_API_KEY 等
# 然后:docker compose --env-file .env.docker up -d

# ── Postgres ────────────────────────────────────────────────────────────
POSTGRES_USER=cnp
POSTGRES_PASSWORD=cnp_dev
POSTGRES_DB=cnp
# Host port (container 5432 暴露到本机的端口) — 仅用于本机调试,容器内永远走 5432
POSTGRES_PORT=5432

# 容器内连接:hostname=service 名 cnp-postgres,内部端口固定 5432
POSTGRES_HOST=cnp-postgres
POSTGRES_PORT_INTERNAL=5432
DATABASE_URL=postgresql://cnp:cnp_dev@cnp-postgres:5432/cnp
DATABASE_ADMIN_URL=postgresql://cnp:cnp_dev@cnp-postgres:5432/cnp

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://cnp-redis:6379

# ── App ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# **生产必改** — 至少 32 字节随机字符串
SESSION_SECRET=docker-demo-please-change-me-in-prod-1234567890abcdef
COOKIE_DOMAIN=

# ── 外部服务(默认 mock,demo 模式无需 key) ─────────────────────────────
# Tavily / Bing / RSS / DDG — mock 走 SimulatedSearchAdapter
SEARCH_API_KIND=yunwu-dr
SEARCH_API_KEY=
TAVILY_API_KEY=

# Yunwu DeepResearch (Gemini Search Grounding) — 推荐搜索源
# 走 yunwu.ai 代理调 Gemini 2.5 Flash with Google Search Grounding tool
# 配置 YUNWU_API_KEY 即生效;不配走 degraded fallback(空召回)
YUNWU_BASE_URL=https://yunwu.ai/v1
YUNWU_API_KEY=
YUNWU_MODEL=gemini-2.5-flash-all
YUNWU_TIMEOUT_MS=180000

# 阿里云 OSS — mock 走本地占位 JPG
OSS_ADAPTER_KEY=mock
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

# 高德地图(geocoder)— 不填走 mock
AMAP_API_KEY=
AMAP_GEOCODE_KEY=
# 前端浏览器地图底图(JS API key,build-time 烤进前端 bundle)
VITE_AMAP_API_KEY=

# LLM(extract / rerank)— 不填则 LLM degraded fallback
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# infer() 客户端读 LLM_API_KEY / LLM_MODEL(不读 DASHSCOPE_*),通常设成一样的值
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_MS=30000

# ── Pipeline 阈值(也可改数据库 app_settings 表运行时改) ──────────────────
NEWS_FRESHNESS_DAYS=30
RELEVANCE_THRESHOLD=50
NEWS_INGEST_INTERVAL_MIN=15

# ── Webhook(模拟外部调度回调)─────────────────────────────────────────
WEBHOOK_HMAC_SECRET=docker-demo-webhook-secret
SIMULATED_GZP_ENABLED=true
SIMULATED_GZP_API_KEY=docker-demo-gzp-key

# ── Debug ───────────────────────────────────────────────────────────────
DEBUG_ROUTES=false
